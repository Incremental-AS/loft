# Cloudflare Workers static assets: response headers.
# Everything is self-hosted, so the policy allows nothing but this origin, and no network calls from scripts.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self'; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=86400

# Universal links (Apple) and app links (Android) for /pair. Both must be served as JSON, with no redirect.
# The apple file has no extension, so its type is set here. build.py copies them from docs/aasa.json and
# android/docs/assetlinks.json when those exist.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# The apps' daily update check (docs/releases-json.md). {} = nothing released yet. Short cache, so a release shows within the hour.
/releases.json
  Content-Type: application/json
  Cache-Control: public, max-age=600
