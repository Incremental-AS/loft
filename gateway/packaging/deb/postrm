#!/bin/sh
set -e
# Settings, keys and the index stay on remove; purge deletes them.
if [ "$1" = purge ]; then
    rm -rf /etc/loft /var/lib/loft
    if getent passwd loft >/dev/null; then
        deluser --system loft >/dev/null 2>&1 || true
    fi
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
exit 0
