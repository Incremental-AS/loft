[Unit]
Description=Loft gateway (serves your SMB shares to the Loft apps)
Documentation=https://loft.incremental.no
After=network-online.target
Wants=network-online.target
# Not before `loft-gateway init` has written the settings.
ConditionPathExists=/etc/loft/gateway.toml

[Service]
User=loft
Group=loft
ExecStart=/opt/loft/venv/bin/loft-gateway --config /etc/loft/gateway.toml
# Master key: made by `loft-gateway init` as an encrypted credential (systemd-creds; bound to
# the TPM when there is one). Never a plain file on disk on a systemd host.
LoadCredentialEncrypted=master.key:/etc/loft/master.key.cred
StateDirectory=loft
# The index holds device rows, wrapped credentials and the audit log: owner only.
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
# A ceiling, so a flood of requests can't take the host's memory with it: past it the
# gateway is killed and restarts. Use grows with the NAS (the index, several shares) and
# with uploads in flight; lower it on a small host with `systemctl edit loft-gateway`.
MemoryMax=2G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Upload chunks spool here (up to upload_chunk_max each). /tmp is a tmpfs on many systems
# (Debian 13), i.e. memory; PrivateTmp's /var/tmp is on disk.
Environment=TMPDIR=/var/tmp
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/loft

[Install]
WantedBy=multi-user.target
