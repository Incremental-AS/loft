<?xml version="1.0" encoding="utf-8"?>
<!-- Copy rules: sentence case, short and plain, name the place ("home", "the NAS",
     "this phone"), never the technology, never call Loft "cloud". -->
<resources>
    <string name="app_name" translatable="false">Loft</string>
    <string name="provider_root_title" translatable="false">Loft</string>

    <!-- Pairing -->
    <string name="welcome_title">Your files, kept at home.</string>
    <string name="pair_body">Loft connects to the Loft gateway on your home network. On the gateway, run loft-gateway pair, then scan the code or open the link on this phone.</string>
    <string name="pair_scan">Scan code</string>
    <string name="pair_paste">Paste link</string>
    <string name="pair_manual">Set up manually</string>
    <string name="pair_paste_title">Paste the pairing link</string>
    <string name="pair_paste_hint">https://loft.incremental.no/pair#…</string>
    <string name="pair_manual_title">Set up manually</string>
    <string name="pair_manual_body">Type the gateway\'s address and one of its key fingerprints. loft-gateway pair shows both. The fingerprint is how Loft checks it\'s really your gateway, so there\'s no setup without it.</string>
    <string name="pair_manual_address">Address</string>
    <string name="pair_manual_address_hint">nas-gateway.local:8443</string>
    <string name="pair_manual_pin">Key fingerprint</string>
    <string name="pair_manual_name">Name (optional)</string>
    <string name="pair_replace_title">Pair with “%1$s”?</string>
    <string name="pair_replace_body">This phone is paired with %1$s. If you pair with another gateway, you\'ll be signed out of %1$s.</string>
    <string name="pair_replace_confirm">Pair</string>
    <string name="pair_continue">Continue</string>
    <string name="pair_scan_title">Scan the pairing code</string>
    <string name="pair_scan_body">Point the camera at the code loft-gateway pair shows.</string>
    <string name="pair_camera_denied">Loft needs the camera to scan the code. You can paste the link instead.</string>
    <string name="pair_err_not_loft">That isn\'t a Loft pairing code.</string>
    <string name="pair_err_version">This code is for a newer version of Loft. Update the app and try again.</string>
    <string name="pair_err_invalid">The pairing code is incomplete or damaged. Make a new one on the gateway.</string>
    <string name="pair_err_https">Loft only connects to a gateway over https.</string>
    <string name="pair_err_pin">The key fingerprint doesn\'t look right. Copy it again from loft-gateway pair.</string>
    <string name="pair_err_address">Type the gateway\'s address.</string>
    <string name="pair_err_no_pin">Loft needs the key fingerprint as well as the address.</string>

    <!-- Sign in -->
    <string name="signin_title">Sign in to your NAS</string>
    <string name="signin_gateway">Gateway: %1$s</string>
    <string name="signin_body">Use the username and password you already have on the NAS. Sign in at home the first time, so your password never passes through anyone else\'s servers. After that, Loft works from anywhere.</string>
    <string name="signin_user">NAS username</string>
    <string name="signin_password">Password</string>
    <string name="signin_button">Sign in</string>
    <string name="signin_help">Loft shows every shared folder this account can open. No account yet? Ask whoever runs the NAS.</string>
    <string name="signin_not_home">You\'re not at home right now. Connect to the home network for the first sign-in. After that, Loft works from anywhere.</string>
    <string name="signin_wrong_password">That username and password didn\'t work on the NAS. Check them and try again.</string>
    <string name="signin_not_allowed">This gateway doesn\'t allow that account. Sign in with your own NAS account.</string>
    <string name="signin_too_many">Too many tries. Wait 15 minutes, then try again.</string>
    <string name="signin_nas_down">The gateway answered, but it can\'t reach the NAS. Try again in a moment.</string>
    <string name="signin_failed">Something went wrong. Try again.</string>
    <string name="forget_gateway">Forget this gateway</string>

