<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tray app. WinUI 3, unpackaged and self-contained (no MSIX, no Windows App SDK runtime
       install): an unsigned MSIX can't be installed by ordinary users, while an unpackaged folder runs
       after SmartScreen's "Run anyway". Cloud Files sync roots work for unpackaged apps. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Loft.App</RootNamespace>
    <AssemblyName>Loft</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\loft.ico</ApplicationIcon>
    <!-- x64 by default; `-p:Platform=ARM64 -r win-arm64` builds the native ARM64 app (CI matrix). -->
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loft.Core\Loft.Core.csproj" />
    <ProjectReference Include="..\Loft.Sync\Loft.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- UI text: every Strings/<language>.json, embedded as "Loft.Strings.<language>.json". A new
       language is a new file; no change here. WithCulture=false keeps MSBuild from treating a name
       like nb.json as a satellite-assembly culture. tests/Loft.Core.Tests embeds the same files. -->
  <ItemGroup>
    <None Remove="Strings\*.json" />
    <EmbeddedResource Include="Strings\*.json" LogicalName="Loft.Strings.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
