<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows integration: the Cloud Files API sync root (Explorer placeholders), the Credential
       Manager token store and the notification-area icon. Win32 P/Invokes are generated by CsWin32
       (NativeMethods.txt). Compiles on Linux too (EnableWindowsTargeting) as a check; runs on Windows. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Loft.Sync</RootNamespace>
    <AssemblyName>Loft.Sync</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CsWin32 needs a target for structs that differ between 32- and 64-bit Windows (NOTIFYICONDATAW). The x64
         layout is also the ARM64 one, so the same Loft.Sync.dll (AnyCPU) serves both 64-bit apps. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <EmitCompilerGeneratedFiles Condition="'$(LoftEmitGenerated)' == 'true'">true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loft.Core\Loft.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Loft.Sync.Tests" />
  </ItemGroup>
</Project>
