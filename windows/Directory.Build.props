<Project>
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Product>Loft</Product>
    <Company>Incremental AS</Company>
    <Copyright>Incremental AS</Copyright>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Lets Linux build the net8.0-windows library (Loft.Sync) as a compile check. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
