<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only: Credential Manager, the loft: protocol and a real Cloud Files sync root driven by an
       in-memory gateway. Compiles anywhere; the tests return early (and say so) off Windows. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Loft.Core\Loft.Core.csproj" />
    <ProjectReference Include="..\..\src\Loft.Sync\Loft.Sync.csproj" />
  </ItemGroup>
</Project>
